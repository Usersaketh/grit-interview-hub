# Public Supabase project settings (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Server-only key. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Canonical public URL, used in redirects and notification links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional outbound email adapter. Email remains disabled if absent.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
